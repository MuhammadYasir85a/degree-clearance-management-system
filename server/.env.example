# Copy to server/.env and fill the required secrets locally. Never commit .env.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL connection string, including sslmode=require.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Development-only registration shortcut. Leave unset in production.
DEMO_OTP=

# Groq generation. Embeddings run locally; no HF token is needed.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Paths resolve relative to server/. Download once, then enable offline mode.
TRANSFORMERS_CACHE=.cache/transformers
TRANSFORMERS_OFFLINE=false
