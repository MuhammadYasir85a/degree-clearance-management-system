generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  department_id     Int                @id @default(autoincrement())
  name              String             @db.VarChar(100)
  code              String             @unique @db.VarChar(10)
  is_active         Boolean            @default(true)
  departmentReviews DepartmentReview[]
  users             User[]

  @@map("departments")
}

model AcademicProgram {
  program_id       Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  code             String            @unique @db.VarChar(20)
  level            String            @db.VarChar(30)
  is_active        Boolean           @default(true)
  eligibleStudents EligibleStudent[]
  users            User[]

  @@map("academic_programs")
}

model EligibleStudent {
  eligible_id         Int                  @id @default(autoincrement())
  registration_no     String               @unique @db.VarChar(30)
  email               String               @unique @db.VarChar(150)
  full_name           String               @db.VarChar(100)
  father_name         String?              @db.VarChar(100)
  cnic                String?              @unique @db.VarChar(15)
  program_id          Int
  batch_year          Int?
  passing_year        Int?
  cgpa                Decimal?             @db.Decimal(3, 2)
  is_registered       Boolean              @default(false)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  program             AcademicProgram      @relation(fields: [program_id], references: [program_id])
  registrationRequest RegistrationRequest?

  @@map("eligible_students")
}

model User {
  user_id            Int                 @id @default(autoincrement())
  department_id      Int?
  full_name          String              @db.VarChar(100)
  father_name        String?             @db.VarChar(100)
  email              String              @unique @db.VarChar(150)
  password_hash      String              @db.VarChar(255)
  role               UserRole            @default(student)
  registration_no    String?             @unique @db.VarChar(30)
  cnic               String?             @unique @db.VarChar(15)
  phone              String?             @db.VarChar(20)
  passing_year       Int?
  cgpa               Decimal?            @db.Decimal(3, 2)
  is_active          Boolean             @default(true)
  auth_version       Int                 @default(0)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  program_id         Int?
  activityLogs       ActivityLog[]
  chatSessions       ChatSession[]
  clearanceRequests  ClearanceRequest[]
  degreeApplications DegreeApplication[]
  departmentReviews  DepartmentReview[]
  notifications      Notification[]
  receipts           Receipt[]
  passwordReset      PasswordResetRequest?
  department         Department?         @relation(fields: [department_id], references: [department_id])
  program            AcademicProgram?    @relation(fields: [program_id], references: [program_id])

  @@map("users")
}

model PasswordResetRequest {
  reset_id         Int       @id @default(autoincrement())
  user_id          Int       @unique
  otp_hash         String    @db.VarChar(64)
  otp_expires_at   DateTime  @db.Timestamptz(6)
  otp_attempts     Int       @default(0)
  locked_until     DateTime? @db.Timestamptz(6)
  reset_token_hash String?   @unique @db.VarChar(64)
  reset_expires_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  user             User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([otp_expires_at])
  @@map("password_reset_requests")
}

model ClearanceRequest {
  clearance_id             Int                @id @default(autoincrement())
  student_id               Int
  status                   ClearanceStatus    @default(draft)
  certificate_uri          String?
  certificate_generated_at DateTime?          @db.Timestamptz(6)
  submitted_at             DateTime?          @db.Timestamptz(6)
  completed_at             DateTime?          @db.Timestamptz(6)
  student                  User               @relation(fields: [student_id], references: [user_id])
  degreeApplication        DegreeApplication?
  departmentReviews        DepartmentReview[]

  @@index([student_id, status])
  @@map("clearance_requests")
}

model DepartmentReview {
  review_id        Int              @id @default(autoincrement())
  clearance_id     Int
  department_id    Int
  officer_id       Int?
  status           ReviewStatus     @default(pending)
  remarks          String?
  student_response String?
  resubmitted_at   DateTime?        @db.Timestamptz(6)
  reviewed_at      DateTime?        @db.Timestamptz(6)
  clearanceRequest ClearanceRequest @relation(fields: [clearance_id], references: [clearance_id], onDelete: Cascade)
  department       Department       @relation(fields: [department_id], references: [department_id])
  officer          User?            @relation(fields: [officer_id], references: [user_id])

  @@unique([clearance_id, department_id])
  @@index([department_id, status])
  @@map("department_reviews")
}

model DegreeApplication {
  degree_app_id    Int              @id @default(autoincrement())
  student_id       Int
  clearance_id     Int              @unique
  status           DegreeStatus     @default(application_started)
  fee_slip_number  String?          @db.VarChar(80)
  verification_slip_number String?  @db.VarChar(80)
  deposit_date     DateTime?        @db.Date
  approved_at      DateTime?        @db.Timestamptz(6)
  ready_at         DateTime?        @db.Timestamptz(6)
  collected_at     DateTime?        @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @updatedAt @db.Timestamptz(6)
  clearanceRequest ClearanceRequest @relation(fields: [clearance_id], references: [clearance_id])
  student          User             @relation(fields: [student_id], references: [user_id])
  documents        Document[]
  receipt          Receipt?

  @@index([student_id, degree_app_id])
  @@index([status, degree_app_id])
  @@map("degree_applications")
}

model Document {
  document_id         Int               @id @default(autoincrement())
  degree_app_id       Int
  document_type       DocType
  file_url            String
  verification_status VerifyStatus      @default(pending)
  remarks             String?
  uploaded_at         DateTime          @default(now()) @db.Timestamptz(6)
  degreeApplication   DegreeApplication @relation(fields: [degree_app_id], references: [degree_app_id], onDelete: Cascade)

  @@unique([degree_app_id, document_type])
  @@map("documents")
}

model Receipt {
  receipt_id        Int               @id @default(autoincrement())
  degree_app_id     Int               @unique
  receipt_number    String            @unique @db.VarChar(30)
  pdf_url           String
  collection_date   DateTime          @db.Date
  generated_by      Int
  generated_at      DateTime          @default(now()) @db.Timestamptz(6)
  degreeApplication DegreeApplication @relation(fields: [degree_app_id], references: [degree_app_id])
  generator         User              @relation(fields: [generated_by], references: [user_id])

  @@map("receipts")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  title           String   @db.VarChar(150)
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

model ActivityLog {
  log_id      Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   Int?
  description String?
  ip_address  String?  @db.VarChar(64)
  details     Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  user        User?    @relation(fields: [user_id], references: [user_id])

  @@map("activity_logs")
}

model ChatSession {
  session_id Int           @id @default(autoincrement())
  user_id    Int
  started_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  ended_at   DateTime?     @db.Timestamptz(6)
  messages   ChatMessage[]
  user       User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, updated_at, session_id])
  @@map("chat_sessions")
}

model ChatMessage {
  message_id Int         @id @default(autoincrement())
  session_id Int
  role       MessageRole
  content    String
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  session    ChatSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id, message_id])
  @@map("chat_messages")
}

model KnowledgeBase {
  kb_id           Int     @id @default(autoincrement())
  title           String  @db.VarChar(200)
  category        String  @db.VarChar(50)
  content         String
  source_document String? @db.VarChar(200)
  embedding       String?
  embedding_model String?  @db.VarChar(100)
  is_active       Boolean @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([is_active, embedding_model])
  @@map("knowledge_base")
}

model RegistrationRequest {
  request_id      Int             @id @default(autoincrement())
  eligible_id     Int             @unique
  cnic            String          @db.VarChar(15)
  phone           String?         @db.VarChar(20)
  password_hash   String          @db.VarChar(255)
  status          String          @default("pending")
  admin_remarks   String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  reviewed_at     DateTime?       @db.Timestamptz(6)
  is_otp_verified Boolean         @default(false)
  otp_code        String?         @db.VarChar(64)
  otp_expires_at  DateTime?       @db.Timestamptz(6)
  otp_attempts    Int             @default(0)
  otp_locked_until DateTime?      @db.Timestamptz(6)
  eligibleStudent EligibleStudent @relation(fields: [eligible_id], references: [eligible_id], onDelete: Cascade)

  @@map("registration_requests")
}

enum UserRole {
  student
  officer
  controller
  admin
}

enum ClearanceStatus {
  draft
  applied
  in_progress
  correction_required
  completed
}

enum ReviewStatus {
  pending
  approved
  rejected
  correction_required
  not_applicable
}

enum DegreeStatus {
  application_started
  documents_uploaded
  controller_review
  degree_processing
  degree_ready
  degree_collected
  completed
}

enum DocType {
  CNIC
  PHOTO
  SSC_DMC
  SSC_CERT
  HSSC_DMC
  HSSC_CERT
  FEE_SLIP
  VERIFICATION_SLIP
  INTERNSHIP
  CLEARANCE_CERT
}

enum VerifyStatus {
  pending
  verified
  rejected
}

enum MessageRole {
  user
  assistant
}
