{
  "info": {
    "name": "UET Milestone 06 - AI RAG Chatbot",
    "description": "Run in order against a development environment after the M06 migration and KnowledgeBase seeding. Uses collection-scoped tokens and temporary article/session IDs. Includes real Groq/Hugging Face calls, authorization/ownership checks, KB CRUD, and cleanup. All requests use base_url ending in /api. This collection sends institutional and authenticated status context to Groq/Hugging Face. Test credentials are development seed fixtures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "m06_invalid_token",
      "value": "invalid.jwt.token",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Login as student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Uses the local development seed account. Update credentials in this request when testing another environment.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"awais@student.uetmardan.edu.pk\",\n  \"password\": \"student123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Response success flag', () => pm.expect(result.success).to.eql(true));",
              "pm.test('student account authenticated', () => { pm.expect(result.token).to.be.a('string').and.not.empty; pm.expect(result.user.role).to.eql('student'); });",
              "if (result.token) pm.collectionVariables.set('m06_student_token', result.token);"
            ]
          }
        }
      ]
    },
