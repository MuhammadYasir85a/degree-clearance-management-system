    {
      "name": "18. Admin creates and embeds KB article",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{m06_admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/chat/admin/kb",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "chat",
            "admin",
            "kb"
          ]
        },
        "description": "Creates one temporary workflow article. The final cleanup removes it. Embedding failure should fail the request without creating an unindexed article.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"M06 Runner Sample: Clearance Corrections\",\n  \"category\": \"clearance_rules\",\n  \"content\": \"When a department requests a correction, read the recorded remarks and resolve the issue with that department. Previously approved reviews remain locked. The authenticated student can inspect their clearance status in the portal.\",\n  \"source_document\": \"M06 Postman test fixture\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.test('Response success flag', () => pm.expect(result.success).to.eql(true));",
              "pm.test('Article created', () => { pm.expect(result.data.kb_id).to.be.a('number'); pm.expect(result.data.title).to.eql('M06 Runner Sample: Clearance Corrections'); pm.expect(result.data.is_active).to.eql(true); });",
