    {
      "name": "07. General RAG question and new session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{m06_student_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/chat/message",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "chat",
            "message"
          ]
        },
        "description": "Requires Groq and Hugging Face credentials with model access and credits, a reachable database with the M06 migration, and seeded embeddings. HTTP 503 is a failed live prerequisite, not a passing AI result.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What documents can I upload for my degree application, and how does departmental clearance work?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Response success flag', () => pm.expect(result.success).to.eql(true));",
              "pm.test('Assistant answer and session returned', () => { pm.expect(result.data.session_id).to.be.a('number'); pm.expect(result.data.content).to.be.a('string').and.not.empty; pm.expect(result.data.role).to.eql('assistant'); pm.expect(result.data.sources).to.be.an('array'); });",
              "pm.test('Sources expose cosine similarity, not a calibrated probability', () => { for (const source of result.data.sources) { pm.expect(source.kb_id).to.be.a('number'); pm.expect(source.title).to.be.a('string'); pm.expect(source.category).to.be.a('string'); pm.expect(source.similarity).to.be.a('number').and.within(-1, 1); } });",
              "if (result.data?.session_id) pm.collectionVariables.set('m06_chat_session_id', result.data.session_id);"
            ]
          }
        }
      ]
    },
